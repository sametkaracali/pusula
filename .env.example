# Pusula News Platform - Environment Variables
# Kopyala: cp .env.example .env

# Groq API Key (AI haber analizi için)
GROQ_API_KEY=gsk_xxxxxxx

# Flask Secret Key (rastgele bir string)
SECRET_KEY=degistir_bunu_rastgele_bir_string_yazin

# Veritabanı (sqlite varsayılan, postgresql de kullanılabilir)
DATABASE_URL=sqlite:///data/pusula.db

# E-posta (Mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAIL_FROM=Pusula <noreply@pusula.com>

# Hava Durumu (OpenWeatherMap)
WEATHER_API_KEY=

# Flask Debug (0=kapalı, 1=açık)
FLASK_DEBUG=0

# Site URL (canlıda domain adresinizi yazın)
SITE_URL=https://pusula.com
SITE_NAME=Pusula
